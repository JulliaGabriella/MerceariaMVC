@model IEnumerable<MerceariaMVC.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<div class="top-bar">

    <div>

        <p class="eyebrow">

            GERENCIAMENTO

        </p>

        <h1 class="page-title">

            Produtos

        </h1>

        <p class="page-subtitle">

            Organize e acompanhe todas as informações.

        </p>

    </div>


    <a asp-action="Create"
       class="btn btn-add">

        <i class="bi bi-plus-lg"></i>

        Novo produto

    </a>

</div>


<div class="table-card">

    @if (Model.Any())
    {

        <table class="table">

            <thead>

                <tr>

                    <th>Nome</th>

                    <th>Preço</th>

                    <th>Estoque</th>

                    <th class="text-end">

                        Ações

                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {

                    <tr>

                        <td>

                            <span class="item-name">

                                @item.Nome

                            </span>

                        </td>


                        <td>

                            R$ @item.Preco.ToString("N2")

                        </td>


                        <td>

                            @item.Estoque unidades

                        </td>


                        <td class="text-end">

                            <a class="action-btn action-edit"
                               title="Editar"
                               asp-action="Edit"
                               asp-route-id="@item.IdProduto">

                                <i class="bi bi-pencil"></i>

                            </a>


                            <a class="action-btn action-details"
                               title="Detalhes"
                               asp-action="Details"
                               asp-route-id="@item.IdProduto">

                                <i class="bi bi-eye"></i>

                            </a>


                            <a class="action-btn action-delete"
                               title="Excluir"
                               asp-action="Delete"
                               asp-route-id="@item.IdProduto">

                                <i class="bi bi-trash"></i>

                            </a>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    }
    else
    {

        <div class="empty-state">

            <i class="bi bi-box-seam fs-1"></i>

            <h4 class="mt-3">

                Nenhum registro encontrado

            </h4>

            <p>

                Comece cadastrando o primeiro item.

            </p>

        </div>

    }

</div>