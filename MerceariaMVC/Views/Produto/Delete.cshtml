@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Excluir";
}

<div class="delete-card">

    <p class="eyebrow">

        ATENÇÃO

    </p>

    <h1 class="page-title">

        Excluir produto?

    </h1>

    <p class="page-subtitle mb-4">

        Esta ação removerá o registro permanentemente.

    </p>


    <div class="detail-row">

        <div class="detail-label">

            Nome

        </div>

        <div class="detail-value">

            @Model.Nome

        </div>

    </div>


    <div class="detail-row">

        <div class="detail-label">

            Preço

        </div>

        <div class="detail-value">

            R$ @Model.Preco.ToString("N2")

        </div>

    </div>


    <div class="detail-row">

        <div class="detail-label">

            Estoque

        </div>

        <div class="detail-value">

            @Model.Estoque unidades

        </div>

    </div>


    <form asp-action="Delete"
          class="form-actions">

        <input type="hidden"
               asp-for="IdProduto" />


        <button type="submit"
                class="btn btn-danger-custom">

            <i class="bi bi-trash"></i>

            Sim, excluir

        </button>


        <a asp-action="Index"
           class="btn btn-secondary-custom">

            Cancelar

        </a>

    </form>

</div>