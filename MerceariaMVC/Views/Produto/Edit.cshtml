@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="top-bar">

    <div>

        <p class="eyebrow">

            CADASTRO

        </p>

        <h1 class="page-title">

            Editar produto

        </h1>

        <p class="page-subtitle">

            Preencha as informações abaixo com atenção.

        </p>

    </div>

</div>


<div class="form-card">

    <form asp-action="Edit">

        <input type="hidden"
               asp-for="IdProduto" />


        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>


        <div class="form-group">

            <label asp-for="Nome"
                   class="form-label">

                Nome do produto

            </label>


            <input asp-for="Nome"
                   class="form-control"
                   placeholder="Ex.: Arroz" />

            <span asp-validation-for="Nome"
                  class="text-danger">

            </span>

        </div>


        <div class="form-group">

            <label asp-for="Preco"
                   class="form-label">

                Preço

            </label>


            <input asp-for="Preco"
                   class="form-control"
                   placeholder="0,00" />

            <span asp-validation-for="Preco"
                  class="text-danger">

            </span>

        </div>


        <div class="form-group">

            <label asp-for="Estoque"
                   class="form-label">

                Quantidade em estoque

            </label>


            <input asp-for="Estoque"
                   class="form-control"
                   placeholder="0" />

            <span asp-validation-for="Estoque"
                  class="text-danger">

            </span>

        </div>


        <div class="form-actions">

            <button type="submit"
                    class="btn btn-add">

                <i class="bi bi-check-lg"></i>

                Salvar alterações

            </button>


            <a asp-action="Index"
               class="btn btn-secondary-custom">

                Cancelar

            </a>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}